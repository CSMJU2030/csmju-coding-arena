// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionStatus {
  PENDING
  EVALUATING // 🎯 เพิ่มบรรทัดนี้: ล็อคสถานะว่า "กำลังตรวจอยู่"
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
}

enum MatchStatus {
  WAITING // ห้องที่สร้างไว้ รอคู่แข่งกดเข้าร่วม
  ACTIVE
  COMPLETED
  DRAW
}

/// ภาษาของคำตอบ — PYTHON เป็นของเดิม (ตรวจบน server) · JS/TS ตรวจในเบราว์เซอร์ของผู้เล่น
enum CodeLanguage {
  PYTHON
  JAVASCRIPT
  TYPESCRIPT
}

enum MatchRoundStatus {
  PENDING
  ACTIVE
  WON
  DRAW
}

model PlayerRating {
  id                   String  @id @default(uuid())
  coreUserId String @unique @map("core_user_id") @db.VarChar(64)
  displayName          String  @unique @map("display_name")
  eloRating            Int     @default(1200) @map("elo_rating")
  hasCompetitiveRating Boolean @default(false) @map("has_competitive_rating")

  problems           Problem[]
  submissions        Submission[]
  queued_match       MatchQueue?
  matchesAsPlayerOne Match[]      @relation("MatchPlayerOne")
  matchesAsPlayerTwo Match[]      @relation("MatchPlayerTwo")
  matchesWon         Match[]      @relation("MatchWinner")
  roundsWon          MatchRound[] @relation("RoundWinner")

  @@map("player_ratings")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Problem {
  id          String  @id @default(uuid())
  authorId    String  @map("author_id")
  title       String
  description String  @db.Text
  timeLimitMs Int     @map("time_limit_ms")
  isActive    Boolean @default(true) @map("is_active")

  author      PlayerRating         @relation(fields: [authorId], references: [id])
  testCases   TestCase[]
  submissions Submission[]
  matchRounds MatchRound[]

  @@map("problems")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model TestCase {
  id             String  @id @default(uuid())
  problemId      String  @map("problem_id")
  inputData      String  @map("input_data") @db.Text
  expectedOutput String  @map("expected_output") @db.Text
  isHidden       Boolean @default(false) @map("is_hidden")

  problem Problem @relation(fields: [problemId], references: [id])

  @@map("test_cases")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Submission {
  id           String           @id @default(uuid())
  studentId    String           @map("student_id")
  problemId    String           @map("problem_id")
  sourceCode   String           @map("source_code") @db.Text
  language     CodeLanguage     @default(PYTHON)
  status       SubmissionStatus @default(PENDING)
  createdAt    DateTime         @default(now()) @map("created_at")
  evaluationStartedAt DateTime? @map("evaluation_started_at")
  evaluatedAt  DateTime?        @map("evaluated_at")
  matchRoundId String?          @map("match_round_id")

  student    PlayerRating        @relation(fields: [studentId], references: [id])
  problem    Problem     @relation(fields: [problemId], references: [id])
  matchRound MatchRound? @relation(fields: [matchRoundId], references: [id])

  @@index([matchRoundId, status, evaluatedAt])
  @@map("submissions")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model MatchQueue {
  id        String   @id @default(uuid())
  playerId  String   @unique @map("player_id")
  createdAt DateTime @default(now()) @map("created_at")

  player PlayerRating @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("match_queue")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Match {
  id          String      @id @default(uuid())
  playerOneId String      @map("player_one_id")
  playerTwoId String?     @map("player_two_id")
  /// ชื่อห้อง (ไม่บังคับ) — ห้องที่สร้างเองแสดงในรายการห้อง
  title       String?     @db.VarChar(60)
  readyPlayerOneAt DateTime? @map("ready_player_one_at")
  readyPlayerTwoAt DateTime? @map("ready_player_two_at")
  winnerId    String?     @map("winner_id")
  status      MatchStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  completedAt DateTime?   @map("completed_at")

  playerOne PlayerRating         @relation("MatchPlayerOne", fields: [playerOneId], references: [id])
  playerTwo PlayerRating?        @relation("MatchPlayerTwo", fields: [playerTwoId], references: [id])
  winner    PlayerRating?        @relation("MatchWinner", fields: [winnerId], references: [id])
  rounds    MatchRound[]

  @@index([playerOneId, status])
  @@index([playerTwoId, status])
  @@index([status, createdAt])
  @@map("matches")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model MatchRound {
  id          String           @id @default(uuid())
  matchId     String           @map("match_id")
  problemId   String           @map("problem_id")
  roundNumber Int              @map("round_number")
  status      MatchRoundStatus @default(PENDING)
  winnerId    String?          @map("winner_id")
  endsAt      DateTime?        @map("ends_at")
  completedAt DateTime?        @map("completed_at")

  match       Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  problem     Problem      @relation(fields: [problemId], references: [id])
  winner      PlayerRating?        @relation("RoundWinner", fields: [winnerId], references: [id])
  submissions Submission[]

  @@unique([matchId, roundNumber])
  @@map("match_rounds")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

enum CssGame {
  FLEXBOX
  GRID
}

/// ด่านเกม CSS ที่ผู้เล่นผ่านแล้ว (Flexbox Adventure / Grid Attack) — แถวละด่าน ใช้คิด XP
/// การตรวจคำตอบเกิดในเบราว์เซอร์ (เทียบ layout จริง) จึงเป็นคะแนนฝึกฝน ไม่ใช่คะแนนแข่งขัน
model LevelClear {
  id         String   @id @default(uuid())
  coreUserId String   @map("core_user_id") @db.VarChar(64)
  game       CssGame
  level      Int
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([coreUserId, game, level])
  @@index([game, createdAt])
  @@map("level_clears")
}
